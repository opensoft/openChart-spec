{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openchart:contract:openchart-ai-clinical-record-write:1.0",
  "title": "openchart-ai-clinical-record-write 1.0",
  "description": "Canonical message schema for the write path by which an external clinical AI system, operating under a declared authority, records AI-authored content in openChart. Owned by opensoft/openChart-spec change define-ai-authored-clinical-records. Tier 1 is the AI consult record (consult.write); Tier 2 is the AI-authored clinical act (act.write), which no 1.x receiver accepts as an act until both the clinical-acts foundation and a future governed amendment put Tier 2 in force and a MINOR version pins the foundation's content schemas. openChart checks every write against its own record of the medical director's authority grant and never trusts the claim a write carries. Under owner ruling 80, every write names its writer (added_by), the AI on whose behalf it was written, by its openWallet ID with the model and model version that produced the content, and any system between them (on_behalf_of), and where its information came from (source). Missing authority never refuses a write: an act.write that fails an authority check is recorded in full as a recommendation that has no effect (write.receipt recorded_as_recommendation, with missing_authority), and a consult.write that fails a grant check is kept as quarantined AI communication (write.receipt quarantined, with quarantine_cause). Only a malformed, unidentified, repeated, non-operational, digest-mismatched or unlinked write, or a write from a suspended writer, is refused, and a refused write stores no clinical content. Every object is closed except act_content.content, the one open object, which is reserved for the content schemas of the clinical-acts foundation. message_id is the idempotency key and carries no PHI. Receipts, notices, status messages and readbacks carry identifiers, digests and codes only, never clinical content; record.readback lets the writing source system confirm what openChart stored. exchange.content_sha256 is the SHA-256 of the RFC 8785 canonical JSON serialization of exchange.turns. A receiver accepts any 1.x message at a MINOR version it declares and refuses any other MAJOR with reason unsupported_major_version.",
  "oneOf": [
    { "$ref": "#/$defs/consultWrite" },
    { "$ref": "#/$defs/actWrite" },
    { "$ref": "#/$defs/authorityNotice" },
    { "$ref": "#/$defs/writeReceipt" },
    { "$ref": "#/$defs/actStatus" },
    { "$ref": "#/$defs/consultReviewed" },
    { "$ref": "#/$defs/readbackRequest" },
    { "$ref": "#/$defs/readbackResult" },
    { "$ref": "#/$defs/grantReadbackRequest" },
    { "$ref": "#/$defs/grantReadback" },
    { "$ref": "#/$defs/messageAck" }
  ],
  "$defs": {
    "contract": { "const": "openchart-ai-clinical-record-write" },
    "contractVersion": {
      "description": "MAJOR.MINOR. Only MAJOR 1 is defined by this schema.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "issuer": {
      "description": "A deployment's configured, stable issuer identifier, unique across deployments and never derived from a host path.",
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "namespaceToken": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "codeToken": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$" },
    "opaqueRef": {
      "description": "Opaque reference. Carries no name, date of birth, contact detail or clinical content.",
      "type": "string",
      "pattern": "^[A-Za-z0-9:_./-]{1,128}$"
    },
    "versionLabel": { "type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mode": {
      "description": "The mode the medical director set. advice_only is the default; limited_practice is an allowlist; full_practice is full practice authority with a reserved list.",
      "enum": ["advice_only", "limited_practice", "full_practice"]
    },
    "context": {
      "description": "Only operational writes may be recorded. scenario and simulation are schema-valid so that the receiver can refuse them with non_operational_context and store nothing.",
      "enum": ["operational", "scenario", "simulation"]
    },
    "sourceSystem": {
      "description": "A system's identity: its issuer and namespace token. As a write's source_system it is the external clinical AI system, and its namespace is the token under which openChart stores its patient references; where the clinical communication record (define-clinical-message-inbox MI-12) defines a source token for the system, the namespace is that token (for example medxfactory). The same shape identifies the writer and every system named in on_behalf_of. The tokens healthlinc and openpractice_agent are never write-path systems, and openchart is never a system namespace (design calls AD-30 and AD-49).",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "namespace"],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "namespace": {
          "allOf": [
            { "$ref": "#/$defs/namespaceToken" },
            { "not": { "enum": ["openchart", "healthlinc", "openpractice_agent"] } }
          ]
        }
      }
    },
    "openchartPatientRef": {
      "description": "The openChart patient triple (openChart issuer, openchart, OC Patient identifier). It is never replaced by an external identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "namespace", "value"],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "namespace": { "const": "openchart" },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "externalPatientRef": {
      "description": "The source system's own patient reference. It must match an active OC Patient External Identifier row on the named OC Patient, in the source system's namespace.",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "namespace", "value"],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "namespace": {
          "allOf": [
            { "$ref": "#/$defs/namespaceToken" },
            { "not": { "const": "openchart" } }
          ]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "conversationRef": {
      "description": "The source system's reference to the conversation, so that an inbox item naming the same conversation can be associated with the consult record by reference. This contract defines no conversation retrieval (owner ruling 69).",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "namespace", "value"],
      "properties": {
        "issuer": { "$ref": "#/$defs/issuer" },
        "namespace": { "$ref": "#/$defs/namespaceToken" },
        "value": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "modelIdentity": {
      "description": "One model the source system used, by identifier and version. role is an optional label for the model's part in producing the content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version"],
      "properties": {
        "model_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$" },
        "model_version": { "$ref": "#/$defs/versionLabel" },
        "role": { "$ref": "#/$defs/codeToken" }
      }
    },
    "openwalletId": {
      "description": "The AI's openWallet ID, as opensoft/openWallet issues it (owner ruling 80, part B). openWallet's public specification anchors a wallet to decentralized identifiers and publishes no format for a wallet's ID, so this contract defines none: openChart treats it as opaque and compares it exactly with the registration of the writer that delivers the write (design call AD-49).",
      "type": "string",
      "pattern": "^[!-~]{1,256}$"
    },
    "systemParty": {
      "description": "A system named on a write: its registered system identity and who operates it (owner ruling 80, part B). openChart compares both with its registration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "system", "operator_ref"],
      "properties": {
        "kind": { "const": "system" },
        "system": { "$ref": "#/$defs/sourceSystem" },
        "operator_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "aiParty": {
      "description": "The AI that produced the content: its openWallet ID, and the model and model version that produced it (owner ruling 80, part B).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "openwallet_id", "model", "model_version"],
      "properties": {
        "kind": { "const": "ai" },
        "openwallet_id": { "$ref": "#/$defs/openwalletId" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$" },
        "model_version": { "$ref": "#/$defs/versionLabel" }
      }
    },
    "onBehalfOf": {
      "description": "Every party the write passed through before its writer, in order from the originator to the writer (owner ruling 80, clause 7): first the AI that produced the content; then, when the writer is a relay, the source system, whose system equals source_system. When the source system is itself the writer, the AI is the only entry. The 1.0 contract admits no other party and no human (design call AD-49).",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [{ "$ref": "#/$defs/aiParty" }],
      "items": { "$ref": "#/$defs/systemParty" }
    },
    "provenanceSource": {
      "description": "Where the information came from (owner ruling 80, clause 5): its kind, and the source system's reference to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["patient_statement", "device_reading", "ai_consult", "clinician_observation", "external_record", "chart_entry"] },
        "ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "evidenceRef": {
      "description": "A reference to evidence the source system relied on, by namespace, reference, version and digest. Evidence content never crosses.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "ref"],
      "properties": {
        "kind": { "enum": ["patient_record", "knowledge_source", "protocol", "other"] },
        "namespace": { "$ref": "#/$defs/namespaceToken" },
        "ref": { "$ref": "#/$defs/opaqueRef" },
        "version": { "$ref": "#/$defs/versionLabel" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityClaim": {
      "description": "The authority the source system says it acted under. openChart compares every field with its own grant record and refuses on any difference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "grant_version", "mode", "configuration_version"],
      "properties": {
        "grant_id": { "$ref": "#/$defs/opaqueRef" },
        "grant_version": { "type": "integer", "minimum": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "configuration_version": { "$ref": "#/$defs/versionLabel" },
        "allowlist_entry_id": { "$ref": "#/$defs/opaqueRef" },
        "protocol_ref": { "$ref": "#/$defs/opaqueRef" },
        "approver_ref": { "$ref": "#/$defs/opaqueRef" },
        "legal_review_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_authority_ref": {
          "description": "The AI system's own reference to the configuration it acted under. openChart records it and, where the grant records one, compares it.",
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "knowledgeBasis": {
      "description": "What an AI turn's or act's clinical statements rest on: the cited evidence, the model's own knowledge with no cited source, or both.",
      "enum": ["cited_sources", "model_knowledge", "mixed"]
    },
    "attachmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "media_type", "sha256"],
      "properties": {
        "ref": { "$ref": "#/$defs/opaqueRef" },
        "media_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]{1,100}$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consultTurn": {
      "description": "One turn of the exchange. author_type uses the author types of the clinical communication record (define-clinical-message-inbox MI-12): patient, representative or ai. A consult write never carries clinician, staff, system or unknown content. Only an ai turn may carry evidence_refs and knowledge_basis.",
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "seq", "author_type", "at", "text"],
      "properties": {
        "turn_id": { "$ref": "#/$defs/opaqueRef" },
        "seq": { "type": "integer", "minimum": 1 },
        "author_type": { "enum": ["patient", "representative", "ai"] },
        "at": { "$ref": "#/$defs/timestamp" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/attachmentRef" }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "knowledge_basis": { "$ref": "#/$defs/knowledgeBasis" }
      },
      "if": { "properties": { "author_type": { "const": "ai" } }, "required": ["author_type"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["evidence_refs"] },
            { "required": ["knowledge_basis"] }
          ]
        }
      }
    },
    "escalation": {
      "description": "Where the source system routed the patient. An AI never manages an emergency; emergency_services_guidance records that the patient was directed to emergency care.",
      "type": "object",
      "additionalProperties": false,
      "required": ["routed_to"],
      "properties": {
        "routed_to": { "enum": ["none", "human_clinician", "emergency_services_guidance"] },
        "route_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "writeEnvelope": {
      "type": "object",
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "source_system", "added_by", "on_behalf_of", "source", "context", "patient", "source_patient_ref", "consent_ref"]
    },
    "consultWrite": {
      "description": "Tier 1. An external clinical AI system records one consult: the full exchange, the models, the evidence references and the authority it operated under. A consult record is AI-generated communication and never a diagnosis or a clinical fact of record. In advice_only mode (owner ruling 66) the AI content gives information, an assessment and next steps, with no diagnosis language and no treatment directives. A consult record is information (owner ruling 80, clause 9): one that fails a grant check is kept as quarantined AI communication and is never refused for that. Its source.kind is always ai_consult.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/$defs/writeEnvelope" },
        { "required": ["consult_id", "consult_version", "authority", "models", "started_at", "ended_at", "exchange", "evidence_refs", "review_flags", "emergency_indicated", "escalation"] }
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "consult.write" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_system": { "$ref": "#/$defs/sourceSystem" },
        "added_by": { "$ref": "#/$defs/systemParty" },
        "on_behalf_of": { "$ref": "#/$defs/onBehalfOf" },
        "source": {
          "allOf": [
            { "$ref": "#/$defs/provenanceSource" },
            { "properties": { "kind": { "const": "ai_consult" } } }
          ]
        },
        "context": { "$ref": "#/$defs/context" },
        "patient": { "$ref": "#/$defs/openchartPatientRef" },
        "source_patient_ref": { "$ref": "#/$defs/externalPatientRef" },
        "consent_ref": { "$ref": "#/$defs/opaqueRef" },
        "consult_id": { "$ref": "#/$defs/opaqueRef" },
        "consult_version": { "type": "integer", "minimum": 1 },
        "predecessor_version": { "type": "integer", "minimum": 1 },
        "conversation_ref": { "$ref": "#/$defs/conversationRef" },
        "authority": { "$ref": "#/$defs/authorityClaim" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/modelIdentity" }
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "exchange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turns", "content_sha256"],
          "properties": {
            "turns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": { "$ref": "#/$defs/consultTurn" },
              "contains": {
                "type": "object",
                "properties": { "author_type": { "const": "ai" } },
                "required": ["author_type"]
              }
            },
            "content_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "summary": {
          "description": "Optional AI-written summary. It is labelled AI-authored and never replaces the exchange.",
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        },
        "evidence_refs": {
          "description": "Required. An empty list is allowed, and puts the consult in the always-review set.",
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "review_flags": {
          "description": "Review category codes the source system declares, drawn from the vocabulary of the medical director's review policy. Two built-in codes always put the consult in review: red_flag, and advice_scope_breach (diagnosis language or a treatment directive in advice-only content).",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/codeToken" }
        },
        "emergency_indicated": { "type": "boolean" },
        "escalation": { "$ref": "#/$defs/escalation" },
        "linked_act_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueRef" }
        }
      }
    },
    "actWrite": {
      "description": "Tier 2. An external clinical AI system records one AI-authored clinical act under limited_practice or full_practice authority. No 1.x receiver accepts it as an act until both the clinical-acts foundation is ratified and built and a future governed amendment puts Tier 2 in force, and a MINOR version of this contract pins the foundation's content schemas. Until then, and whenever an act fails an authority check, openChart records it in full as a recommendation that has no effect and answers recorded_as_recommendation with missing_authority (owner ruling 80).",
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        { "$ref": "#/$defs/writeEnvelope" },
        { "required": ["act_id", "act_version", "act_class", "act_type", "authority", "models", "occurred_at", "evidence_refs", "declared_reserved", "emergency_indicated", "act_content"] }
      ],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "act.write" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_system": { "$ref": "#/$defs/sourceSystem" },
        "added_by": { "$ref": "#/$defs/systemParty" },
        "on_behalf_of": { "$ref": "#/$defs/onBehalfOf" },
        "source": { "$ref": "#/$defs/provenanceSource" },
        "context": { "$ref": "#/$defs/context" },
        "patient": { "$ref": "#/$defs/openchartPatientRef" },
        "source_patient_ref": { "$ref": "#/$defs/externalPatientRef" },
        "consent_ref": { "$ref": "#/$defs/opaqueRef" },
        "act_id": { "$ref": "#/$defs/opaqueRef" },
        "act_version": { "type": "integer", "minimum": 1 },
        "act_class": { "enum": ["order", "prescription", "diagnosis_of_record", "treatment_plan_change"] },
        "act_type": { "$ref": "#/$defs/codeToken" },
        "authority": {
          "allOf": [
            { "$ref": "#/$defs/authorityClaim" },
            { "required": ["approver_ref", "legal_review_ref"] },
            {
              "if": { "properties": { "mode": { "const": "limited_practice" } }, "required": ["mode"] },
              "then": { "required": ["allowlist_entry_id", "protocol_ref"] }
            }
          ]
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/modelIdentity" }
        },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "consult_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consult_id"],
          "properties": {
            "consult_id": { "$ref": "#/$defs/opaqueRef" },
            "consult_version": { "type": "integer", "minimum": 1 }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "knowledge_basis": { "$ref": "#/$defs/knowledgeBasis" },
        "conditions_met": {
          "description": "For limited_practice: each condition of the allowlist entry that the source system states was met, with its evidence.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition_ref", "evidence_refs"],
            "properties": {
              "condition_ref": { "$ref": "#/$defs/opaqueRef" },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": { "$ref": "#/$defs/evidenceRef" }
              }
            }
          }
        },
        "declared_reserved": {
          "description": "Whether the source system classifies the act as reserved (for example controlled-substance prescribing). openChart also applies its own classification; either one makes the act reserved.",
          "type": "boolean"
        },
        "emergency_indicated": {
          "description": "Whether the act is part of managing an emergency. true is never accepted as an act: openChart records it as a recommendation and lists it urgently.",
          "type": "boolean"
        },
        "supersedes_act": {
          "description": "A prior AI-authored act by the same source system that this act visibly supersedes. A clinician-authored record can never be named here.",
          "type": "object",
          "additionalProperties": false,
          "required": ["act_id", "act_version"],
          "properties": {
            "act_id": { "$ref": "#/$defs/opaqueRef" },
            "act_version": { "type": "integer", "minimum": 1 }
          }
        },
        "target_record_ref": {
          "description": "The existing chart record that the act acts upon, if any. A clinician-authored target is never acted upon: the write is recorded as a recommendation with missing_authority targets_clinician_record.",
          "$ref": "#/$defs/opaqueRef"
        },
        "act_content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_schema", "content"],
          "properties": {
            "content_schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "sha256"],
              "properties": {
                "id": { "$ref": "#/$defs/codeToken" },
                "version": { "$ref": "#/$defs/versionLabel" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "content": {
              "description": "The one open object. It is validated against the clinical-acts foundation's content schema named by content_schema, at that digest, once a MINOR version of this contract pins it. Until then openChart stores it as given, with the content_schema it declares, in a recommendation.",
              "type": "object"
            }
          }
        }
      }
    },
    "authorityNotice": {
      "description": "A change in authority or in the source's standing. From the AI system, only a reduction (paused or narrowed) is accepted, and openChart applies it at once; a widening is only ever the medical director's act in openChart. From openChart, every change to its grant is announced, and so is every change to the source's standing: suspended (a manual suspension; every write is refused), cap_suspended (a cap suspension; non-urgent consults are refused), deregistered (the last notice before the identity stops being served), suspension_lifted (either kind of suspension lifted) and no_medical_director (no medical director designation is in force, so no grant is current). grant_id and configuration_version are required for a grant change, and present for a standing change only where a grant exists.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "source_system", "direction", "change", "effective_at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "authority.notice" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_system": { "$ref": "#/$defs/sourceSystem" },
        "direction": { "enum": ["from_ai_system", "from_openchart"] },
        "grant_id": { "$ref": "#/$defs/opaqueRef" },
        "grant_version": { "type": "integer", "minimum": 1 },
        "change": { "enum": ["paused", "narrowed", "resumed", "expired", "revoked", "superseded", "suspended", "cap_suspended", "deregistered", "suspension_lifted", "no_medical_director"] },
        "effective_at": { "$ref": "#/$defs/timestamp" },
        "configuration_version": { "$ref": "#/$defs/versionLabel" },
        "new_mode": { "$ref": "#/$defs/mode" },
        "removed_allowlist_entry_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueRef" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "direction": { "const": "from_ai_system" } }, "required": ["direction"] },
          "then": { "properties": { "change": { "enum": ["paused", "narrowed"] } } }
        },
        {
          "if": { "properties": { "change": { "enum": ["paused", "narrowed", "resumed", "expired", "revoked", "superseded"] } }, "required": ["change"] },
          "then": { "required": ["grant_id", "configuration_version"] }
        },
        {
          "if": { "properties": { "change": { "enum": ["suspended", "cap_suspended", "deregistered", "suspension_lifted", "no_medical_director"] } }, "required": ["change"] },
          "then": { "properties": { "direction": { "const": "from_openchart" } } }
        }
      ]
    },
    "grantReadbackRequest": {
      "description": "The source system, or the relay acting for it, asks openChart for the state of its own authority, as a heartbeat. It carries no patient or clinical content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "source_system"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "grant.readback_request" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_system": { "$ref": "#/$defs/sourceSystem" }
      }
    },
    "grantReadback": {
      "description": "openChart's answer to a grant readback, from its own records at read time, with no patient or clinical content. unauthorized answers an identity that is not the source's registered one or its relay, and a manually suspended or deregistered identity. grant_current means an active grant with a medical director designation in force; grant_not_current gives the reason. source_status says whether the source is cap-suspended.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "in_reply_to", "result", "read_at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "grant.readback" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "in_reply_to": { "$ref": "#/$defs/uuid" },
        "result": { "enum": ["grant_current", "grant_not_current", "unauthorized"] },
        "read_at": { "$ref": "#/$defs/timestamp" },
        "source_status": { "enum": ["active", "cap_suspended"] },
        "not_current_reason": { "enum": ["no_grant", "grant_paused", "grant_expired", "grant_revoked", "no_medical_director"] },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant_id", "grant_version", "mode", "configuration_version", "state", "effective_at"],
          "properties": {
            "grant_id": { "$ref": "#/$defs/opaqueRef" },
            "grant_version": { "type": "integer", "minimum": 1 },
            "mode": { "$ref": "#/$defs/mode" },
            "configuration_version": { "$ref": "#/$defs/versionLabel" },
            "state": { "enum": ["active", "paused", "expired", "revoked"] },
            "effective_at": { "$ref": "#/$defs/timestamp" },
            "expires_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "grant_current" } }, "required": ["result"] },
          "then": {
            "required": ["source_status", "grant"],
            "properties": { "grant": { "properties": { "state": { "const": "active" } } } },
            "not": { "required": ["not_current_reason"] }
          }
        },
        {
          "if": { "properties": { "result": { "const": "grant_not_current" } }, "required": ["result"] },
          "then": { "required": ["source_status", "not_current_reason"] }
        },
        {
          "if": { "properties": { "result": { "const": "unauthorized" } }, "required": ["result"] },
          "then": { "not": { "anyOf": [{ "required": ["source_status"] }, { "required": ["grant"] }, { "required": ["not_current_reason"] }] } }
        }
      ]
    },
    "rejectReason": {
      "description": "Why a write or notice was refused. A refused write stores no clinical content. Missing authority is never a reason to refuse an addition (owner ruling 80, clause 18), so no authority check appears here.",
      "enum": [
        "schema_invalid",
        "unsupported_major_version",
        "unauthorized",
        "non_operational_context",
        "patient_link_unknown",
        "patient_link_mismatch",
        "patient_link_in_review",
        "conflicting_duplicate",
        "content_digest_mismatch",
        "notice_would_widen"
      ]
    },
    "missingAuthority": {
      "description": "The first authority check an act.write failed, in the receiver's order; the act is recorded as a recommendation marked not_authorized_decision (owner ruling 80, clause 13). Two codes keep names that end in refused: they name the missing authority and refuse nothing.",
      "enum": [
        "tier2_not_in_force",
        "act_type_unsupported",
        "no_current_grant",
        "grant_paused",
        "grant_expired",
        "grant_revoked",
        "grant_mismatch",
        "mode_mismatch",
        "mode_not_permitted",
        "approver_mismatch",
        "legal_review_mismatch",
        "emergency_management_refused",
        "reserved_act_refused",
        "targets_clinician_record",
        "allowlist_entry_unknown",
        "allowlist_entry_mismatch",
        "conditions_unverified"
      ]
    },
    "quarantineCause": {
      "description": "Why a consult.write was kept as quarantined AI communication rather than accepted: the first grant check it failed, or source_cap_suspended for an emergency or red-flag consult from a cap-suspended source.",
      "enum": [
        "no_current_grant",
        "grant_paused",
        "grant_expired",
        "grant_revoked",
        "grant_mismatch",
        "mode_mismatch",
        "mode_not_permitted",
        "approver_mismatch",
        "legal_review_mismatch",
        "source_cap_suspended"
      ]
    },
    "writeReceipt": {
      "description": "openChart's answer to every write and every authority notice it receives. accepted and duplicate carry record_ref. recorded_as_recommendation answers an act.write that failed an authority check: openChart recorded it in full as a recommendation that has no effect, and missing_authority names the first check it failed (owner ruling 80). quarantined answers a consult.write that failed a grant check: openChart kept it as quarantined AI communication, never accepted, and quarantine_cause names why. A duplicate of either carries the original's code. refused carries a reason and no record_ref, and a refused write stores no clinical content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "in_reply_to", "write_kind", "result", "received_at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "write.receipt" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "in_reply_to": { "$ref": "#/$defs/uuid" },
        "write_kind": { "enum": ["consult", "act", "authority_notice"] },
        "result": { "enum": ["accepted", "duplicate", "recorded_as_recommendation", "quarantined", "refused"] },
        "reason": { "$ref": "#/$defs/rejectReason" },
        "missing_authority": { "$ref": "#/$defs/missingAuthority" },
        "quarantine_cause": { "$ref": "#/$defs/quarantineCause" },
        "record_ref": { "$ref": "#/$defs/opaqueRef" },
        "grant_checked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant_id", "grant_version"],
          "properties": {
            "grant_id": { "$ref": "#/$defs/opaqueRef" },
            "grant_version": { "type": "integer", "minimum": 1 }
          }
        },
        "co_review_due_at": { "$ref": "#/$defs/timestamp" },
        "received_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "refused" } }, "required": ["result"] },
          "then": {
            "required": ["reason"],
            "not": { "anyOf": [{ "required": ["record_ref"] }, { "required": ["missing_authority"] }, { "required": ["quarantine_cause"] }] }
          }
        },
        {
          "if": { "properties": { "result": { "const": "accepted" } }, "required": ["result"] },
          "then": {
            "required": ["record_ref"],
            "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["missing_authority"] }, { "required": ["quarantine_cause"] }] }
          }
        },
        {
          "if": { "properties": { "result": { "const": "recorded_as_recommendation" } }, "required": ["result"] },
          "then": {
            "required": ["record_ref", "missing_authority"],
            "properties": { "write_kind": { "const": "act" } },
            "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["quarantine_cause"] }] }
          }
        },
        {
          "if": { "properties": { "result": { "const": "quarantined" } }, "required": ["result"] },
          "then": {
            "required": ["record_ref", "quarantine_cause"],
            "properties": { "write_kind": { "const": "consult" } },
            "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["missing_authority"] }] }
          }
        },
        {
          "if": { "properties": { "result": { "const": "duplicate" } }, "required": ["result"] },
          "then": {
            "required": ["record_ref"],
            "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["missing_authority", "quarantine_cause"] }] },
            "allOf": [
              { "if": { "required": ["missing_authority"] }, "then": { "properties": { "write_kind": { "const": "act" } } } },
              { "if": { "required": ["quarantine_cause"] }, "then": { "properties": { "write_kind": { "const": "consult" } } } }
            ]
          }
        }
      ]
    },
    "actStatus": {
      "description": "openChart reports what happened to an accepted AI-authored act: co-review outcome, reversal, cancellation or hand-off on narrowing or pause, and overdue escalation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "act_id", "act_version", "record_ref", "status", "at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "act.status" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "act_id": { "$ref": "#/$defs/opaqueRef" },
        "act_version": { "type": "integer", "minimum": 1 },
        "record_ref": { "$ref": "#/$defs/opaqueRef" },
        "status": {
          "enum": [
            "co_review_confirmed",
            "co_review_amended",
            "co_review_voided",
            "voided",
            "countermanded",
            "cancelled_on_narrowing",
            "handed_to_clinician",
            "co_review_overdue_escalated"
          ]
        },
        "reviewer_ref": { "$ref": "#/$defs/opaqueRef" },
        "reason_code": { "$ref": "#/$defs/codeToken" },
        "at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "consultReviewed": {
      "description": "openChart reports the outcome of a clinician review of a consult record, as a code only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "consult_id", "consult_version", "record_ref", "outcome", "at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "consult.reviewed" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "consult_id": { "$ref": "#/$defs/opaqueRef" },
        "consult_version": { "type": "integer", "minimum": 1 },
        "record_ref": { "$ref": "#/$defs/opaqueRef" },
        "outcome": { "enum": ["concur", "concur_with_note", "follow_up_required", "unsafe"] },
        "at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "readbackRequest": {
      "description": "The source system that wrote a record, or the relay acting for it, asks openChart what it stored. Only the writing source system's integration identity may ask.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "practice_ref", "source_system", "write_kind", "record_ref"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "record.readback_request" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "practice_ref": { "$ref": "#/$defs/opaqueRef" },
        "source_system": { "$ref": "#/$defs/sourceSystem" },
        "write_kind": { "enum": ["consult", "act"] },
        "record_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "readbackResult": {
      "description": "openChart's answer to a readback request: the stored record's identifiers, its stored content digest, when openChart received it, the grant version it was checked against and its current state, as codes and digests only. For a consult, stored_content_sha256 is recomputed from the stored turns exactly as exchange.content_sha256 is defined; for an act, it is the SHA-256 of the RFC 8785 canonical JSON serialization of the stored act_content. A recommendation (record_state recommendation, with missing_authority) and a quarantined consult (record_state quarantined, with quarantine_cause) are found but never accepted; neither reports a review status, and each carries grant_checked only where a grant was checked.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "in_reply_to", "write_kind", "record_ref", "result", "read_at"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "record.readback" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "in_reply_to": { "$ref": "#/$defs/uuid" },
        "write_kind": { "enum": ["consult", "act"] },
        "record_ref": { "$ref": "#/$defs/opaqueRef" },
        "result": { "enum": ["found", "not_found", "unauthorized"] },
        "source_record_id": { "$ref": "#/$defs/opaqueRef" },
        "source_record_version": { "type": "integer", "minimum": 1 },
        "stored_content_sha256": { "$ref": "#/$defs/sha256" },
        "grant_checked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant_id", "grant_version"],
          "properties": {
            "grant_id": { "$ref": "#/$defs/opaqueRef" },
            "grant_version": { "type": "integer", "minimum": 1 }
          }
        },
        "received_at": { "$ref": "#/$defs/timestamp" },
        "record_state": {
          "enum": ["recorded", "superseded", "voided", "countermanded", "cancelled", "handed_to_clinician", "recommendation", "quarantined"]
        },
        "missing_authority": { "$ref": "#/$defs/missingAuthority" },
        "quarantine_cause": { "$ref": "#/$defs/quarantineCause" },
        "review_status": {
          "enum": ["not_selected", "selected", "in_review", "reviewed", "co_review_pending", "co_review_overdue", "co_review_done"]
        },
        "read_at": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "properties": { "result": { "const": "found" } }, "required": ["result"] },
      "then": {
        "required": ["source_record_id", "source_record_version", "stored_content_sha256", "received_at", "record_state"],
        "allOf": [
          {
            "if": { "properties": { "record_state": { "const": "recommendation" } }, "required": ["record_state"] },
            "then": {
              "properties": { "write_kind": { "const": "act" } },
              "required": ["missing_authority"],
              "not": { "anyOf": [{ "required": ["quarantine_cause"] }, { "required": ["review_status"] }] }
            }
          },
          {
            "if": { "properties": { "record_state": { "const": "quarantined" } }, "required": ["record_state"] },
            "then": {
              "properties": { "write_kind": { "const": "consult" } },
              "required": ["quarantine_cause"],
              "not": { "anyOf": [{ "required": ["missing_authority"] }, { "required": ["review_status"] }] }
            }
          },
          {
            "if": { "properties": { "record_state": { "enum": ["recorded", "superseded", "voided", "countermanded", "cancelled", "handed_to_clinician"] } }, "required": ["record_state"] },
            "then": {
              "required": ["grant_checked", "review_status"],
              "not": { "anyOf": [{ "required": ["missing_authority"] }, { "required": ["quarantine_cause"] }] }
            }
          }
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["source_record_id"] },
            { "required": ["source_record_version"] },
            { "required": ["stored_content_sha256"] },
            { "required": ["received_at"] },
            { "required": ["grant_checked"] },
            { "required": ["record_state"] },
            { "required": ["missing_authority"] },
            { "required": ["quarantine_cause"] },
            { "required": ["review_status"] }
          ]
        }
      }
    },
    "messageAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "message_type", "message_id", "sent_at", "in_reply_to", "result"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "message_type": { "const": "message.ack" },
        "message_id": { "$ref": "#/$defs/uuid" },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "in_reply_to": { "$ref": "#/$defs/uuid" },
        "result": { "const": "received" }
      }
    }
  }
}
